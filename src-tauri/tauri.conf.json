{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "EMS",
  "version": "0.1.0",
  "identifier": "com.ems.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "EMS",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "transparent": false,
        "shadow": true,
        "focus": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb",
      "nsis",
      "msi",
      "dmg"
    ],
    "category": "Business",
    "shortDescription": "Exchange Management System",
    "longDescription": "Exchange management for sarafi shops: exchanges, contacts, hawala and cash operations.",
    "copyright": "\u00a9 2026 EMS",
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": true,
        "installMode": "perMachine",
        "startMenuFolder": "EMS",
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
